+                        vst1q_u16((U16*)(dt+uStart+8), vecD8);
+                        uStart += 16;
+                    }
+                }
+                break;
+            }
+            symbol += symbolCount;
+            rankStart += symbolCount * length;
+        }
+    }
+    return iSize;
+}
