#!/bin/bash
set -e  # 遇到错误立即退出
echo "Running pre-installation cleanup for zip package..."

implementer=$(grep "CPU implementer" /proc/cpuinfo | awk 'NR==1{print $4}')
part=$(grep "CPU part" /proc/cpuinfo | awk 'NR==1{print $4}')
if [ "${implementer}" != "0x48" ]; then
    echo "WARNING: Not Kunpeng CPU - hardware acceleration disabled"
fi

exit 0
