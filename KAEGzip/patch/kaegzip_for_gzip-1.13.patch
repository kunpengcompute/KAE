+
+/* ===========================================================================
+ * Read a new buffer from the current input file, perform end-of-line
+ * translation.
+ * Because KAE hardware has integrated CRC checksum functionality,
+ * Do Not update the crc. Only Update the input file size.
+ * IN assertion: size >= 2 (for end-of-line translation)
+ */
+int
+file_read_for_kae (char *buf, unsigned size)
+{
+    unsigned len;
+
+    Assert(insize == 0, "inbuf not empty");
+
+    len = read_buffer (ifd, buf, size);
+    if (len == 0) return (int)len;
+    if (len == (unsigned)-1) {
+        read_error();
+    }
+
+    bytes_in += (off_t)len;
+    return (int)len;
+}
