+/* ===========================================================================
+ * Deflate in to out Using KAE (if no KAE, fall back to zlib)
+ * data stream: input file --> inbuf -> compress -> outbuf --> output file
+ */
+int
+kae_zip (int in, int out)
+{
+    ifd = in;
+    ofd = out;
+    outcnt = 0;
+
+    z_stream stream;
+    int ret;
+    /* allocate deflate state */
+    stream.zalloc = Z_NULL;
+    stream.zfree = Z_NULL;
+    stream.opaque = Z_NULL;
+    // using default level parameter
+    ret = deflateInit2_(&stream, level, Z_DEFLATED, 31, 8, Z_DEFAULT_STRATEGY, "1.2.11", sizeof(z_stream));
+    if (ret != Z_OK) {
+        fprintf (stderr, "\n%s: Compress Failed, ERROR %d.\n", program_name, ret);
+        abort_gzip();
+    }
+
+    /* compress until end of file */
+    int read_bytes = 0;
+    int have = 0;
+    int flush = Z_NO_FLUSH;
+    do {
+        // read data from file using file_read API
+        read_bytes = file_read_for_kae(inbuf, INBUFSIZ);
+        // if read_buf returns 0, it has reached the end of file
+        flush = (read_bytes == 0) ? Z_FINISH : Z_NO_FLUSH;
+        stream.avail_in = read_bytes;
+        stream.next_in = inbuf;
+        /* passing input data to deflate */
+        do {
+            stream.avail_out = OUTBUFSIZ;
+            stream.next_out = outbuf;
+            ret = deflate(&stream, flush);
+            if (ret == Z_STREAM_ERROR) {
+                fprintf (stderr, "\n%s: Compress Failed.\n", program_name);
+                abort_gzip();
+            }
+            have = OUTBUFSIZ - stream.avail_out;
+            write_buf(ofd, outbuf, have);
+        } while (stream.avail_out == 0);
+    } while (flush != Z_FINISH);
+    (void)deflateEnd(&stream);
+    
+#ifndef NO_SIZE_CHECK
+  /* Check input size
+   * (but not on MSDOS -- diet in TSR mode reports an incorrect file size)
+   */
+    if (ifile_size != -1L && bytes_in != ifile_size) {
+        fprintf(stderr, "%s: %s: file size changed while zipping\n",
+                program_name, ifname);
+    }
+#endif
+    
+    header_bytes = 18;
+
+    return OK;
+}
 
 /* ===========================================================================
