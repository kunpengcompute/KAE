 }
+
+/* ===========================================================================
+ * Unzip in to out using KAE. This routine works on gzip file only.
+ * This function will reset fd at the start, because KAE inflate() needs the 
+ * header bytes which has been processed in get_method().
+ * After Inflate Step, reset "inptr" pointer, because unzip may be called 
+ * later, it's necessary to make sure that unzip can start reading data 
+ * from buffer at a correct position.
+ */
+int
+kae_unzip (int in, int out)
+{
+    ifd = in;
+    ofd = out;
+
+    /* Reset fd using bytes_in */
+    off_t new_pos = lseek(ifd, -bytes_in, SEEK_CUR);
+    if (new_pos == (off_t) -1) {
+        fprintf(stderr, "Input file damaged.\n");
+        close(ifd);
+        return ERROR;
+    }
+
+    clear_bufs();
+
+    int ret;
+    z_stream stream;
+
+    /* allocate inflate state */
+    stream.zalloc = Z_NULL;
+    stream.zfree = Z_NULL;
+    stream.opaque = Z_NULL;
+    ret = inflateInit2_(&stream, 31, "1.2.11", sizeof(z_stream));
+    if (ret != Z_OK) {
+        fprintf (stderr, "\n%s: Dompress Failed, ERROR %d.\n", program_name, ret);
+        abort_gzip();
+    }
+
+    /* decompress until deflate stream ends or end of file */
+    int read_bytes = 0;
+    int have = 0;
+    do {
+        read_bytes = file_read_for_kae(inbuf, INBUFSIZ);
+        if (read_bytes == 0) {
+            break;
+        }
+        stream.avail_in = read_bytes;
+        stream.next_in = inbuf;
+
+        /* run inflate() on input until output buffer not full */
+        do {
+            stream.avail_out = OUTBUFSIZ;
+            stream.next_out = outbuf;
+            ret = inflate(&stream, Z_NO_FLUSH);
+            switch (ret) {
+            case Z_STREAM_ERROR:
+            case Z_NEED_DICT:
+                ret = Z_DATA_ERROR;     /* and fall through */
+            case Z_DATA_ERROR:
+            case Z_MEM_ERROR:
+                (void)inflateEnd(&stream);
+                gzip_error("Invalid Compressed Data.");
+                return ret;
+            }
+            have = OUTBUFSIZ - stream.avail_out;
+            write_buf(ofd, outbuf, have);
+        } while (stream.avail_out == 0);
+    } while (ret != Z_STREAM_END);
+
+    // update inptr & insize
+    insize = read_bytes;
+    inptr = insize - stream.avail_in;
+
+    /* clean up and return */
+    (void)inflateEnd(&stream);
+
+    if (ret != Z_STREAM_END) {
+        gzip_error("Invalid Compressed Data.");
+        return ERROR;
+    }
+    return OK;
+}
