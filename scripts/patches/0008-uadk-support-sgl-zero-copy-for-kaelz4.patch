+
+struct mix_pool {
+    void *buf_pool;
+    void *usr_pool;
+    struct wd_sgl *sgl;
+    wd_map iova_map;
+};
+
+static void *wd_alloc_blk_in_build_sgl(void *pool, size_t size)
+{
+    struct mix_pool *mix_pool = pool;
+
+    if (mix_pool->sgl->priv)
+        return mix_pool->sgl->priv;
+
+    return wd_alloc_blk_sgl(mix_pool->buf_pool, size);
+}
+
+static void wd_free_blk_in_build_sgl(void *pool, void *blk)
+{
+    struct mix_pool *mix_pool = pool;
+
+    return wd_free_blk(mix_pool->buf_pool, blk);
+}
+
+static void *wd_iova_map_in_build_sgl(void *pool, void *va, size_t size)
+{
+    struct mix_pool *mix_pool = pool;
+    return mix_pool->iova_map(mix_pool->usr_pool, va, size);
+}
+
+int wd_build_sgl(struct wd_queue *q, void *pool, struct wd_sgl *sgl, const struct wd_buf_list *buf_list, wd_map usr_map)
+{
+    int ret = -WD_ENOMEM;
+    struct wd_sglpool *sgl_pool = pool;
+
+    sgl->buf_num = buf_list->buf_num;
+    sgl->sge_num = buf_list->buf_num;
+    sgl->pool = pool;
+    for (int i = 0; i < sgl->buf_num; i++) {
+        sgl->sge[i].flag = 0;
+        sgl->sge[i].buf = buf_list->buf[i].data;
+        sgl->sge[i].data_len = buf_list->buf[i].buf_len;
+        sgl->sge[i].sgl = sgl;
+    }
+
+    sgl->sge[sgl->buf_num - 1].flag |= FLAG_SGE_END;
+
+    struct mix_pool mix_pool;
+    mix_pool.buf_pool = sgl_pool->buf_br.usr;
+    mix_pool.usr_pool = buf_list->usr_data;
+    mix_pool.iova_map = usr_map;
+    mix_pool.sgl = sgl;
+    sgl_pool->buf_br.iova_map = wd_iova_map_in_build_sgl;
+    sgl_pool->buf_br.alloc = wd_alloc_blk_in_build_sgl;
+    sgl_pool->buf_br.free = wd_free_blk_in_build_sgl;
+    sgl_pool->buf_br.usr = &mix_pool;
+    ret = drv_init_sgl(q, pool, sgl);
+    sgl_pool->buf_br.alloc = wd_alloc_blk_sgl;
+    sgl_pool->buf_br.free = wd_free_blk;
+    sgl_pool->buf_br.iova_map = wd_blk_iova_map_sgl;
+    sgl_pool->buf_br.usr = mix_pool.buf_pool;
+    if (ret) {
+        WD_ERR("initialize hardware sgl failed, ret = %d\n", ret);
+    }
+
+	return ret;
+}
+
+int wd_destory_sgl(struct wd_queue *q, void *pool, struct wd_sgl *sgl)
+{
+    return drv_uninit_sgl(q, pool, sgl);
+}
